<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Harens | My Portfolio</title>
<style>
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;background:#090b20;color:#f5f5ff;font-family:Arial,sans-serif;line-height:1.6}
@keyframes float{50%{transform:translateY(-12px) rotate(4deg)}}
@keyframes shine{50%{box-shadow:0 0 35px #58f6ff88}}
@keyframes appear{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
nav{position:sticky;top:0;z-index:5;text-align:center;padding:15px;background:#11152ff5;border-bottom:1px solid #454b76}
nav b{display:block;font-size:22px;color:#58f6ff}
nav a{display:inline-block;color:white;text-decoration:none;margin:6px;padding:5px;transition:.3s}
nav a:hover{color:#58f6ff;transform:translateY(-3px)}
header{text-align:center;padding:65px 18px;background:radial-gradient(ellipse at top,#29285f,#090b20 75%)}
.avatar{display:grid;place-items:center;width:125px;height:125px;margin:auto;border-radius:50%;background:linear-gradient(135deg,#58f6ff,#a78bfa,#ff72c6);color:#090b20;font-size:42px;font-weight:bold;animation:float 4s infinite ease-in-out,shine 3s infinite}
h1{font-size:clamp(32px,7vw,60px);line-height:1.2}
.gradient{background:linear-gradient(90deg,#58f6ff,#c5aaff,#ff72c6);background-clip:text;-webkit-background-clip:text;color:transparent}
header p{max-width:650px;margin:18px auto;color:#bdc5e3}
.btn{display:inline-block;padding:12px 18px;margin:6px;border:0;border-radius:12px;background:#58f6ff;color:#090b20;font-weight:bold;text-decoration:none;cursor:pointer;transition:.25s}
.btn:hover{transform:translateY(-4px);box-shadow:0 0 22px #58f6ff77}
.wrap{width:90%;max-width:900px;margin:auto}
section{padding:35px 0;scroll-margin-top:90px;animation:appear .6s ease}
.kicker{color:#ffb36b;letter-spacing:2px;font-size:13px}
h2{font-size:29px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:15px}
.card{padding:20px;border-radius:18px;background:linear-gradient(145deg,#1b2750,#11152f);border:1px solid #414873;transition:.3s}
.card:hover{transform:translateY(-5px);border-color:#58f6ff;box-shadow:0 10px 30px #58f6ff19}
.card h3{color:#58f6ff}
.icon{font-size:32px}
details{margin:13px 0;padding:17px;border-radius:16px;background:#151a3b;border:1px solid #414873;transition:.3s}
details[open]{border-color:#58f6ff;box-shadow:0 0 20px #58f6ff22}
summary{cursor:pointer;font-weight:bold;color:#58f6ff;font-size:17px}
details p{color:#c1c9e3}
label{display:block;margin:13px 0 5px;font-weight:bold;color:#dce4ff}
input,select,textarea{width:100%;padding:13px;border-radius:11px;border:1px solid #49527c;background:#0b102b;color:white;font:inherit;outline:none;transition:.25s}
input:focus,select:focus,textarea:focus{border-color:#58f6ff;box-shadow:0 0 15px #58f6ff22}
textarea{resize:vertical;min-height:130px}
.formbox{padding:clamp(18px,4vw,32px);background:linear-gradient(145deg,#191f46,#10132d);border:1px solid #54508a;border-radius:22px}
footer{text-align:center;padding:30px 15px;color:#aab5d6;border-top:1px solid #343b65}
@media(max-width:500px){nav a{margin:3px;font-size:13px}.hero{padding-top:45px}.formbuttons .btn{width:100%;margin:6px 0}}
</style>
</head>
<body>

<nav>
<b>HC. PORTFOLIO ✨</b>
